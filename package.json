    "test:commissions": "node --test src/lib/commissions/calculations.test.mjs",
    "test:network": "node --test src/lib/referrals/binary-tree.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "admin:promote": "node --env-file=.env scripts/promote-admin.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.0",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "boring-avatars": "^2.0.4",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "jose": "^6.2.10",
    "next": "16.0.8",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.5.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
